# Onde o modelo treinado é salvo/carregado
AI_MODELS_DIR=models
# Fuso horário usado para extrair a hora do dia das leituras
AI_TIMEZONE=America/Sao_Paulo
# Capacidade dos potes (usada para alertas de nível baixo)
FOOD_BOWL_CAPACITY_G=300
WATER_BOWL_CAPACITY_ML=1000
# Se não houver modelo salvo, treina com dados sintéticos ao subir a API
AUTO_TRAIN_SYNTHETIC=true
# Token exigido no header X-Admin-Token para POST /train (vazio = sem proteção)
AI_ADMIN_TOKEN=
