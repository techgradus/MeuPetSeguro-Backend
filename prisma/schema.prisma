
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  photoUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pets Pet[]
  passwordResets PasswordReset[]

  @@map("users")
}

model Pet {
  id        String    @id @default(uuid())
  name      String
  species   String
  breed     String?
  birthDate DateTime?
  weightKg  Float?
  notes     String?
  photoUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tutorId String
  tutor   User   @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  vaccines Vaccine[]
  alerts   Alert[]

  devices Device[]

  @@map("pets")
  @@index([tutorId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

enum DeviceType {
  COLLAR
  FOOD_BOWL
  WATER_BOWL
}

enum DeviceStatus {
  ONLINE
  OFFLINE
}

model Device {
  id           String       @id @default(uuid())
  type         DeviceType
  deviceCode   String       @unique
  status       DeviceStatus @default(OFFLINE)
  batteryLevel Int?
  lastSyncAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@map("devices")
}


// Model mínimo para o alerta de vacina. As rotas/CRUD ficam no módulo de vacinas.
model Vaccine {
  id         String    @id @default(uuid())
  name       String
  appliedAt  DateTime
  nextDoseAt DateTime?
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  alerts Alert[]

  @@index([petId])
  @@map("vaccines")
}

enum AlertType {
  LOW_FOOD
  LOW_WATER
  INACTIVITY
  ACTIVITY_ANOMALY
  DEVICE_OFFLINE
  VACCINE_DUE
}

model Alert {
  id        String    @id @default(uuid())
  type      AlertType
  message   String
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  petId String
  pet   Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  // Preenchido só em alertas de vacina; evita gerar dois alertas para a mesma vacina
  vaccineId String?
  vaccine   Vaccine? @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([vaccineId])
  @@map("alerts")
}
