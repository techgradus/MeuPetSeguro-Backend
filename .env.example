PORT=3000

DATABASE_URL="postgresql://postgres:SENHA@HOST:5432/NOME_DO_BANCO?schema=public"

# Broker MQTT (dispositivos IoT)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

SIM_COLLAR_DEVICE_CODE=COLEIRA-01
SIM_FOOD_BOWL_DEVICE_CODE=POTE-COMIDA-01
SIM_WATER_BOWL_DEVICE_CODE=POTE-AGUA-01

# Serviço de IA (pasta ai-service/). Vazio = análise automática desativada
AI_API_URL=http://127.0.0.1:8001
# Mesmo valor de AI_ADMIN_TOKEN do ai-service (protege o re-treino)
AI_API_KEY=
# De quantos em quantos minutos a IA analisa os pets e gera alertas
AI_ANALYSIS_INTERVAL_MIN=10

JWT_SECRET=
JWT_EXPIRES_IN=

SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MeuPet Seguro <no-reply@meupetseguro.app>"